{
  "name": "jest-environment-performance",
  "version": "1.0.0",
  "scripts": {
    "generate-tests": "tsx scripts/generate-tests.ts",
    "test:node": "jest --clearCache && jest --config jest.config.node.mjs",
    "test:jsdom": "jest --clearCache && jest --config jest.config.jsdom.mjs",
    "test:vitest": "vitest run --config vitest.config.ts"
  },
  "keywords": [
    "jest",
    "jsdom",
    "performance"
  ],
  "author": "Mikihiro SUDA",
  "license": "MIT",
  "description": "Jest を無駄に jsdom 環境で実行した場合どれくらい遅くなるのか",
  "devDependencies": {
    "@eslint/js": "9.23.0",
    "@tsconfig/strictest": "2.0.5",
    "@types/jest": "29.5.14",
    "@types/node": "22.13.16",
    "eslint": "9.23.0",
    "eslint-config-prettier": "10.1.1",
    "globals": "16.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "prettier": "3.5.3",
    "ts-jest": "29.3.1",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "typescript-eslint": "8.29.0",
    "vitest": "^3.1.1"
  }
}
